{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartmenu",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-11",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/m/*"] },
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "smartmenu" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "smartmenu-photos" }],
  "queues": {
    "producers": [{ "binding": "PHOTO_JOBS", "queue": "smartmenu-photo-jobs" }],
    "consumers": [{ "queue": "smartmenu-photo-jobs", "max_batch_size": 1, "max_retries": 2, "max_concurrency": 4 }]
  },
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "101", "simple": { "limit": 8, "period": 60 } }
  ],
  "vars": {
    "XAI_MODEL": "grok-4.20-non-reasoning",
    "XAI_VISION_MODEL": "grok-4.3",
    "XAI_IMAGE_MODEL": "grok-imagine-image-2.0",
    "XAI_BASE_URL": "",
    "OPENAI_MODEL": "gpt-6-luna",
    "VISION_MODEL": "gpt-6-luna",
    "OPENAI_REASONING": "low",
    "IMAGE_PROVIDER": "openai",
    "IMAGE_MODEL": "gpt-image-2.5-sunburst",
    "ADMIN_EMAILS": "",
    "PUBLIC_ORIGIN": ""
  },
  "observability": { "enabled": true }
}
