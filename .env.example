AUTH_SECRET=generate-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Menu extraction from photos
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Dish photo enhancement (pick one or both)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

DATABASE_URL=./data/smartmenu.db

# Append LLM request/response + cost estimates (default: ./llm.log)
# LLM_LOG_PATH=./llm.log

# Folder with editable .txt prompts (default: ./prompts)
# PROMPTS_DIR=./prompts

# --- Dish cut-out cost dials (all optional) ---
# gpt-image-1 accepts 1024x1024, 1536x1024, 1024x1536 or auto — there is no
# arbitrary pixel size, so `quality` is the real cost lever.
# Output tokens per 1024x1024: low ~272, medium ~1056, high ~4160.
# gpt-image-2 preserves the dish; gpt-image-1 redraws it. Worth the ~20%.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1024
# Longest edge we upload. Input is billed by dimension, so sending a 2000px
# photo to render 1024px pays twice for pixels the model discards.
DISH_IMAGE_INPUT_MAX_PX=1024
# input_fidelity=high sounds like the fix for "it redrew my food" but measured
# worse on a real dish and cost 3.3x. Left at the API default.
OPENAI_INPUT_FIDELITY=low
